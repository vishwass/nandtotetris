// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    Not(in= sel[0], out= notsel0);
    Not(in= sel[1], out= notsel1);
    Not(in= sel[2], out= notsel2);

    Or(a= sel[0], b=sel[1] , out= selAtemp);
    Or(a= selAtemp, b= sel[2], out= selAInv );
    Not(in= selAInv, out= selA);

    And(a= sel[0], b= notsel1 , out= selBT);
    And(a= selBT, b= notsel2, out= selB);

    And(a= notsel0, b= sel[1] , out= selCT);
    And(a= selCT, b= notsel2, out= selC);

    And(a= sel[0], b= sel[1] , out= selDT);
    And(a= selDT, b= notsel2, out= selD);

    And(a= notsel0, b= notsel1 , out= selET);
    And(a= selET, b= sel[2], out= selE);

    And(a= sel[0], b= notsel1 , out= selFT);
    And(a= selFT, b= sel[2], out= selF);

    And(a= notsel0, b= sel[1] , out= selGT);
    And(a= selGT, b= sel[2], out= selG);

    And(a= sel[0], b= sel[1] , out= selHT);
    And(a= selHT, b= sel[2], out= selH);


    And(a= in, b= selA, out=a);
    And(a= in, b= selB, out=b);
    And(a= in, b= selC, out=c);
    And(a= in, b= selD, out=d);
    And(a= in, b= selE, out=e);
    And(a= in, b= selF, out=f);
    And(a= in, b= selG, out=g);
    And(a= in, b= selH, out=h);
    }