// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:

    Inc16(in= out6, out= outIncd);
  
    Mux16(a= out6, b= outIncd, sel= inc, out= outInc);
    Mux16(a= outInc, b= in, sel= load, out= out4);

    And16(a= out4, b= false , out= outreset);
    Mux16(a= out4, b= outreset, sel= reset, out= out5);

    Or(a= inc, b= load , out= l1);
    Or(a= l1, b= reset, out= l2 );
    Register(in= out5, load= l2, out= out6, out=out );

    

   



    



}