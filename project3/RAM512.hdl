// File name: projects/3/b/RAM512.hdl
/**
 * Memory of 512 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    Not(in= address[6], out= a6not );
    Not(in= address[7], out= a7not );
    Not(in= address[8], out= a8not );

    And(a= address[6], b=load , out= lda6);
    And(a= address[7], b=load , out= lda7);
    And(a= address[8], b=load , out= lda8);
    And(a= a6not, b=load , out= lda6n);
    And(a= a7not, b=load , out= lda7n);
    And(a= a8not, b=load , out= lda8n);
    
    //0-63 reg load - 345 are all 0
    And(a= lda6n, b= lda7n , out= ld1tmp);
    And(a= ld1tmp, b= lda8n , out= ld1);
    // select within 0 - 63
    RAM64(in= in, load=ld1 , address= address[0..5], out= out0 );

    And(a= lda6, b=lda7n , out= ld2tmp );
    And(a= ld2tmp, b= lda8n , out= ld2);
    RAM64(in= in, load=ld2 , address= address[0..5], out= out1 );

    And(a= lda6n, b=lda7 , out= ld3tmp );
    And(a= ld3tmp, b= lda8n , out= ld3);
    RAM64(in= in, load=ld3 , address= address[0..5], out= out2 );

    And(a= lda6, b=lda7 , out= ld4tmp );
    And(a= ld4tmp, b= lda8n , out= ld4);
    RAM64(in= in, load=ld4 , address= address[0..5], out= out3 );

    And(a= lda6n, b=lda7n , out= ld5tmp );
    And(a= ld5tmp, b= lda8 , out= ld5);
    RAM64(in= in, load=ld5 , address= address[0..5], out= out4 );

    And(a= lda6, b=lda7n , out= ld6tmp );
    And(a= ld6tmp, b= lda8 , out= ld6);
    RAM64(in= in, load=ld6, address= address[0..5], out= out5 );

    And(a= lda6n, b=lda7 , out= ld7tmp );
    And(a= ld7tmp, b= lda8 , out= ld7);
    RAM64(in= in, load=ld7, address= address[0..5], out= out6 );

    And(a= lda6, b=lda7 , out= ld8tmp );
    And(a= ld8tmp, b= lda8 , out= ld8);
    RAM64(in= in, load=ld8 , address= address[0..5], out= out7 );

    Mux8Way16(a= out0, b= out1, c= out2, d= out3, e= out4, f= out5, g= out6, h= out7, sel= address[6..8], out= out);

}