// File name: projects/3/a/RAM64.hdl
/**
 * Memory of sixty four 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    Not(in= address[3], out= a3not );
    Not(in= address[4], out= a4not );
    Not(in= address[5], out= a5not );

    And(a= address[3], b=load , out= lda3);
    And(a= address[4], b=load , out= lda4);
    And(a= address[5], b=load , out= lda5);
    And(a= a3not, b=load , out= lda3n);
    And(a= a4not, b=load , out= lda4n);
    And(a= a5not, b=load , out= lda5n);
    
    //0-7 reg load - 345 are all 0
    And(a= lda3n, b= lda4n , out= ld7tmp);
    And(a= ld7tmp, b= lda5n , out= ld7);
    // select within 7 
    RAM8(in= in, load=ld7 , address= address[0..2], out= out0 );

    //8-15 reg load - 3rd bit is 1, others 0
    And(a= lda3, b=lda4n , out= ld15tmp );
    And(a= ld15tmp, b= lda5n , out= ld15);
    // select btw 8 to 15
    RAM8(in= in, load=ld15 , address= address[0..2], out= out1 );

    //16-23 reg load 
    And(a= lda3n, b=lda4 , out= ld23tmp );
    And(a= ld23tmp, b= lda5n , out= ld23);
    // select btw 16-23
    RAM8(in= in, load=ld23 , address= address[0..2], out= out2 );

    //24-31 reg load 
    And(a= lda3, b=lda4 , out= ld31tmp );
    And(a= ld31tmp, b= lda5n , out= ld31);
    // select btw 24-31
    RAM8(in= in, load=ld31 , address= address[0..2], out= out3 );

    //32-39 reg load 
    And(a= lda3n, b=lda4n , out= ld39tmp );
    And(a= ld39tmp, b= lda5 , out= ld39);
    // select btw 32-39
    RAM8(in= in, load=ld39 , address= address[0..2], out= out4 );

    //40-47 reg load 
    And(a= lda3, b=lda4n , out= ld47tmp );
    And(a= ld47tmp, b= lda5 , out= ld47);
    // select btw 40-47
    RAM8(in= in, load=ld47 , address= address[0..2], out= out5 );

     //48-55 reg load 
    And(a= lda3n, b=lda4 , out= ld55tmp );
    And(a= ld55tmp, b= lda5 , out= ld55);
    // select btw 48-55
    RAM8(in= in, load=ld55 , address= address[0..2], out= out6 );

    //56-63 reg load 
    And(a= lda3, b=lda4 , out= ld63tmp );
    And(a= ld63tmp, b= lda5 , out= ld63);
    // select btw 56-63
    RAM8(in= in, load=ld63 , address= address[0..2], out= out7 );

    Mux8Way16(a= out0, b= out1, c= out2, d= out3, e= out4, f= out5, g= out6, h= out7, sel= address[3..5], out= out);

}